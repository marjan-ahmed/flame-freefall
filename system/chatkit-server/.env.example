# ChatKit Server Environment Variables
# Copy to .env in this directory (system/chatkit-server/.env)
# The main.py loads from the repo root .env by default, but you can also
# set these directly in your hosting platform.

# Groq API key for the LLM (required for chat responses)
GROQ_API_KEY=

# Optional fallback Groq key (same account shares quota)
# GROQ_API_KEY_FALLBACK=

# Hugging Face token for fallback model (optional)
# HF_TOKEN=

# Database URL for ChatKit Postgres store (same as KSOR_DB_URL)
# In production (Vercel): use Neon connection string with pooling
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# MCP door URL for the handbook tools (ksor serve)
# In production (Fly.io): https://your-fly-app.fly.dev/mcp
# HANDBOOK_MCP_URL=http://127.0.0.1:8080/mcp

# Base URL for attachment uploads (the ChatKit backend)
# In production (Vercel): https://your-vercel-app.vercel.app
# ATTACHMENT_BASE_URL=http://127.0.0.1:8000

# CORS origins for the ChatKit backend (comma-separated)
# In production: https://your-github-pages-site.github.io,https://your-custom-domain.com
# CORS_ORIGINS=http://localhost:3000