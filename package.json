{
  "name": "flame-freefall",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "patch-package",
    "dev": "npm --prefix system/site run dev",
    "build": "ksor build && npm --prefix system/site run build",
    "preview": "node system/site/preview.mjs",
    "check": "node .agents/skills/format-checker/check.mjs",
    "check:decision": "node scripts/check-decision-contexts.mjs",
    "verify:release": "node scripts/verify-release.mjs",
    "evaluate:research": "node scripts/evaluate-research-scenarios.mjs",
    "provision": "npm run schema && npm run grant",
    "serve": "node scripts/ksor-local.mjs serve",
    "refresh": "ksor build && npm run ingest && npm run gc",
    "schema": "node scripts/ksor-local.mjs schema --instance instance.md --apply",
    "grant": "node scripts/ksor-local.mjs grant --instance instance.md",
    "ingest": "node scripts/ksor-local.mjs ingest --instance instance.md --flip",
    "gc": "node scripts/ksor-local.mjs gc --instance instance.md",
    "calibrate": "node scripts/ksor-local.mjs calibrate --instance instance.md"
  },
  "dependencies": {
    "@panaversity/ksor": "0.0.60",
    "patch-package": "^8.0.1"
  },
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "system/site",
    "system/gateways/*",
    "system/packages/*"
  ]
}
