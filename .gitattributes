# Checkout bytes are provenance bytes: markdown is LF on every platform so
# the same commit hashes identically on Windows, macOS, and Linux.
* text=auto
*.md text eol=lf
docs/presentation/*.pdf binary
docs/presentation/*.pptx binary
docs/presentation/**/*.png binary
instance.md text eol=lf

# Dataset fingerprints must identify the same bytes on Windows and Linux.
psi-data/derived/*.json text eol=lf
psi-data/query-fixtures.json text eol=lf
system/chatkit-server/data/*.json text eol=lf

# Saved source extractions retain their original whitespace for verification.
psi-data/derived/report-extractions/*.md whitespace=-blank-at-eol,-blank-at-eof
psi-data/extracted/literature/*.md whitespace=-blank-at-eol,-blank-at-eof
